---
import Base from "../layouts/Base.astro";
import { listNotes } from "../lib/db";

const prefillCode = Astro.url.searchParams.get("course") ?? "";
const notes = listNotes();
---

<Base title="Course notes">
  <h1>Course notes</h1>
  <p>
    Spotted something wrong, or worth flagging about a course above — a class
    number that's since changed, a note for next year's list? Add it here.
    Notes are shared and stick around across a reload.
  </p>
  <form method="post" action="/api/notes">
    <label for="courseCode">Course code</label>
    <input id="courseCode" name="courseCode" required maxlength="20" value={prefillCode} />
    <label for="body">Note</label>
    <input id="body" name="body" required maxlength="500" />
    <button>Add note</button>
  </form>
  <ul id="notes">
    {
      notes.map((note) => (
        <li>
          <strong>{note.courseCode}</strong> — {note.body}{" "}
          <small>({note.createdAt})</small>
        </li>
      ))
    }
  </ul>
</Base>
