---
import Base from "../layouts/Base.astro";
import { type Course, coursesScrapedAt, listCourses, listLikedCourseCodes } from "../lib/db";

const LEVELS = [1000, 2000, 3000, 4000, 5000, 6000, 7000, 8000, 9000] as const;
const OFFERINGS = [
  { value: "first_sem", label: "First Semester" },
  { value: "second_sem", label: "Second Semester" },
  { value: "no_offerings", label: "No current offerings" },
] as const;

// ANU's own session names, abbreviated for a table cell that otherwise runs
// wide — "Quarter 1/First Semester/Quarter 2/Quarter 3/Second Semester/
// Quarter 4" becomes "Q1/Sem 1/Q2/Q3/Sem 2/Q4".
const SESSION_ABBREVIATIONS: Record<string, string> = {
  "First Semester": "Sem 1",
  "Second Semester": "Sem 2",
  "Quarter 1": "Q1",
  "Quarter 2": "Q2",
  "Quarter 3": "Q3",
  "Quarter 4": "Q4",
};

function abbreviateSession(session: string): string {
  if (!session) return "(not listed)";
  return session
    .split("/")
    .map((part) => SESSION_ABBREVIATIONS[part.trim()] ?? part.trim())
    .join("/");
}

function levelOf(course: Course): number {
  return Number(course.courseCode[4]) * 1000;
}

function offeringMatches(course: Course, offering: string): boolean {
  if (offering === "first_sem") return course.firstSemClassNumber !== null;
  if (offering === "second_sem") return course.secondSemClassNumber !== null;
  if (offering === "no_offerings") return !course.hasAnyOffering;
  return false;
}

const allCourses = listCourses();
const likedCodes = listLikedCourseCodes();

const q = (Astro.url.searchParams.get("q") ?? "").trim().toLowerCase();
const likedFirst = Astro.url.searchParams.get("likedFirst") === "1";

// On the very first visit there's no query string at all, and every box
// should read as ticked (showing everything) rather than none — that's the
// "haven't filtered yet" state, distinct from "submitted with every box
// unticked" (which should show nothing from that group, taken literally).
// The hidden "submitted" field is how the two are told apart.
const formSubmitted = Astro.url.searchParams.has("submitted");
const selectedOfferings = formSubmitted
  ? Astro.url.searchParams.getAll("offering")
  : OFFERINGS.map((o) => o.value);
const selectedLevels = formSubmitted ? Astro.url.searchParams.getAll("level").map(Number) : [...LEVELS];

// Each checkbox group is OR'd internally (tick "First Semester" and "Second
// Semester" to see courses confirmed in either) and AND'd across groups.
// Every level actually present in the data (1000-9000) has a checkbox, so
// there's no "orphan" level left needing an exemption from this filter.
function matches(course: Course): boolean {
  const matchesQuery =
    q === "" || course.courseCode.toLowerCase().includes(q) || course.name.toLowerCase().includes(q);
  const matchesOffering = !formSubmitted || selectedOfferings.some((o) => offeringMatches(course, o));
  const matchesLevel = !formSubmitted || selectedLevels.includes(levelOf(course));
  return matchesQuery && matchesOffering && matchesLevel;
}

const filtered = allCourses.filter(matches);
if (likedFirst) {
  // Array.prototype.sort is stable, so courses within "liked" and within
  // "not liked" keep their existing courseCode order.
  filtered.sort((a, b) => Number(likedCodes.has(b.courseCode)) - Number(likedCodes.has(a.courseCode)));
}

const anuUrl = (code: string) => `https://programsandcourses.anu.edu.au/2027/course/${code.toLowerCase()}`;
// Liking a row is a plain form POST + redirect (no JS) — a full page
// navigation, which defaults to scrolling to the top. Pointing the redirect
// at the row's own anchor keeps you where you were instead.
const returnTo = (code: string) => `${Astro.url.pathname}${Astro.url.search}#${code}`;
---

<Base title="COMP courses — 2027">
  <h1>COMP courses — 2027</h1>
  <p>
    ANU's own course search only tells you what's on offer one course page at
    a time. This checked all {allCourses.length} COMP-prefixed courses' own
    Offerings pages directly (scraped {coursesScrapedAt.slice(0, 10)}): {" "}
    {allCourses.filter((c) => c.firstSemClassNumber).length} run First Semester,{" "}
    {allCourses.filter((c) => c.secondSemClassNumber).length} run Second Semester, and{" "}
    {allCourses.filter((c) => !c.hasAnyOffering).length} are listed as if active but have
    zero current offerings at all.
  </p>

  <form method="get" action="/" class="filters">
    <input type="hidden" name="submitted" value="1" />
    <div class="filter-row">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" value={q} placeholder="code or title" />
    </div>

    <fieldset>
      <legend>Offering (tick any)</legend>
      {
        OFFERINGS.map((o) => (
          <label>
            <input type="checkbox" name="offering" value={o.value} checked={selectedOfferings.includes(o.value)} />
            {o.label}
          </label>
        ))
      }
    </fieldset>

    <fieldset>
      <legend>Level (tick any)</legend>
      {
        LEVELS.map((lvl) => (
          <label>
            <input type="checkbox" name="level" value={lvl} checked={selectedLevels.includes(lvl)} />
            {lvl}
          </label>
        ))
      }
    </fieldset>

    <label>
      <input type="checkbox" name="likedFirst" value="1" checked={likedFirst} />
      Show liked first
    </label>

    <button>Filter</button>
  </form>

  <p>
    Showing {filtered.length} of {allCourses.length} courses.
  </p>

  <table>
    <thead>
      <tr>
        <th scope="col">Code</th>
        <th scope="col">Title</th>
        <th scope="col">First Sem class no.</th>
        <th scope="col">Second Sem class no.</th>
        <th scope="col">Running in</th>
        <th scope="col">Liked</th>
        <th scope="col">Links</th>
      </tr>
    </thead>
    <tbody>
      {
        filtered.map((course) => {
          const liked = likedCodes.has(course.courseCode);
          return (
            <tr id={course.courseCode} class={course.hasAnyOffering ? "" : "no-offerings"}>
              <td>{course.courseCode}</td>
              <td>{course.name}</td>
              <td>{course.firstSemClassNumber ?? "—"}</td>
              <td>{course.secondSemClassNumber ?? "—"}</td>
              <td>{abbreviateSession(course.catalogueSession)}</td>
              <td>
                <form method="post" action="/api/likes" class="like-form">
                  <input type="hidden" name="courseCode" value={course.courseCode} />
                  <input type="hidden" name="returnTo" value={returnTo(course.courseCode)} />
                  <button
                    type="submit"
                    class="like-button"
                    aria-label={liked ? `Unlike ${course.courseCode}` : `Like ${course.courseCode}`}
                  >
                    {liked ? "♥" : "♡"}
                  </button>
                </form>
              </td>
              <td>
                <a href={anuUrl(course.courseCode)}>ANU page</a>
              </td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</Base>
